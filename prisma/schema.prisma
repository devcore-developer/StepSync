generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  STUDENT
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum UsmleStage {
  PREPARING_STEP1
  PREPARING_STEP2CK
  PREPARING_STEP3
}

enum ScheduleTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StudyPlanStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ABANDONED
}

enum StudyPlanSource {
  TEMPLATE
  AI
  CUSTOM
}

enum TaskType {
  VIDEO
  NOTES
  QBANK
  REVIEW
  PRACTICE
  CUSTOM
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PAUSED
}

enum PartnerRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum GroupMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum GroupStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum NotificationType {
  TASK_REMINDER
  MISSED_TASK
  FALLING_BEHIND
  MILESTONE_REACHED
  PARTNER_REQUEST
  PARTNER_ACCEPTED
  PARTNER_REJECTED
  MESSAGE_RECEIVED
  GROUP_INVITE
  JOIN_REQUEST
  JOIN_ACCEPTED
  JOIN_REJECTED
  GROUP_MEMBER_REMOVED
  GROUP_MEMBER_PROMOTED
  SYSTEM_ANNOUNCEMENT
  DRIFT_WARNING
  RESCHEDULE_COMPLETED
  AI_RECOMMENDATION
}

enum StudyLocationType {
  LIBRARY
  CAFE
  PRIVATE_SPACE
  OTHER
}

enum ResourceType {
  VIDEO
  READING
  QBANK
  NOTES
  LECTURE
  REVIEW
  OTHER
}

// ==========================================
// MODELS
// ==========================================

model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  passwordHash            String?
  role                    UserRole                @default(STUDENT)
  isOnboarded             Boolean                 @default(false)
  emailVerified           DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  studyPlans              StudyPlan[]
  sentPartnerRequests     StudyPartnerRequest[]   @relation("SentPartnerRequests")
  receivedPartnerRequests StudyPartnerRequest[]   @relation("ReceivedPartnerRequests")
  groupMemberships        GroupMember[]
  notifications           Notification[]
  createdTemplates        ScheduleTemplate[]      @relation("TemplateCreator")
  accounts                Account[]
  sessions                Session[]
  conversationsAsA        Conversation[]          @relation("ConvoParticipantA")
  conversationsAsB        Conversation[]          @relation("ConvoParticipantB")
  conversationMembers     ConversationMember[]
  sentMessages            Message[]
  profile                 Profile?
  adminAuditLogs          AdminAuditLog[]
  notificationPreference  NotificationPreference?

  @@map("users")
}

model Profile {
  id                       String      @id @default(cuid())
  userId                   String      @unique
  firstName                String?
  lastName                 String?
  academicYear             String?
  university               String?
  gender                   Gender?
  bio                      String?
  currentUsmleStage        UsmleStage?
  currentSystemId          String?
  currentChapterId         String?
  residenceArea            String?
  preferredStudyTime       String?
  studyPreferences         Json?
  preferredStudyLocationId String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentSystem          UsmleSystem?   @relation(fields: [currentSystemId], references: [id], onDelete: SetNull)
  currentChapter         Chapter?       @relation(fields: [currentChapterId], references: [id], onDelete: SetNull)
  preferredStudyLocation StudyLocation? @relation(fields: [preferredStudyLocationId], references: [id], onDelete: SetNull)

  @@index([academicYear])
  @@index([currentSystemId])
  @@index([currentChapterId])
  @@index([gender])
  @@index([currentUsmleStage])
  @@index([preferredStudyLocationId])
  @@map("profiles")
}

model UsmleSystem {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters           Chapter[]
  templateMilestones ScheduleTemplateMilestone[]
  planMilestones     StudyPlanMilestone[]
  currentInProfiles  Profile[]
  currentInGroups    StudyGroup[]                @relation("GroupCurrentSystem")
  resources          Resource[]                  @relation("SystemResources")

  @@map("usmle_systems")
}

model Chapter {
  id          String   @id @default(cuid())
  systemId    String
  name        String
  slug        String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  system            UsmleSystem            @relation(fields: [systemId], references: [id], onDelete: Restrict)
  templateTasks     ScheduleTemplateTask[]
  planTasks         StudyPlanTask[]
  currentInProfiles Profile[]
  currentInGroups   StudyGroup[]           @relation("GroupCurrentChapter")
  resources         Resource[]

  @@unique([systemId, name])
  @@map("chapters")
}

model Resource {
  id                String       @id @default(cuid())
  name              String
  slug              String
  type              ResourceType
  description       String?
  url               String?
  estimatedDuration Int?
  systemId          String?
  chapterId         String?
  isActive          Boolean      @default(true)
  order             Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  system        UsmleSystem?           @relation("SystemResources", fields: [systemId], references: [id], onDelete: SetNull)
  chapter       Chapter?               @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  templateTasks ScheduleTemplateTask[]
  planTasks     StudyPlanTask[]

  @@map("resources")
}

model StudyLocation {
  id          String            @id @default(cuid())
  name        String
  type        StudyLocationType
  description String?
  city        String?
  area        String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  groups             StudyGroup[] @relation("GroupStudyLocation")
  profilePreferences Profile[]

  @@map("study_locations")
}

// ==========================================
// SCHEDULE TEMPLATES (Reusable Blueprints)
// ==========================================

model ScheduleTemplate {
  id                    String                 @id @default(cuid())
  title                 String
  slug                  String                 @unique
  description           String?
  durationWeeks         Int
  recommendedStudyHours Int?
  creatorId             String?
  status                ScheduleTemplateStatus @default(DRAFT)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  creator    User?                       @relation("TemplateCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  milestones ScheduleTemplateMilestone[]
  plans      StudyPlan[]

  @@map("schedule_templates")
}

model ScheduleTemplateMilestone {
  id             String   @id @default(cuid())
  templateId     String
  title          String
  description    String?
  order          Int      @default(0)
  systemId       String?
  startDayOffset Int?
  endDayOffset   Int?
  estimatedWeeks Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  template ScheduleTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  system   UsmleSystem?           @relation(fields: [systemId], references: [id], onDelete: SetNull)
  tasks    ScheduleTemplateTask[]

  @@map("schedule_template_milestones")
}

model ScheduleTemplateTask {
  id             String   @id @default(cuid())
  milestoneId    String
  title          String
  description    String?
  type           TaskType
  resourceId     String?
  chapterId      String?
  estimatedHours Float?
  startDayOffset Int?
  isOptional     Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  milestone ScheduleTemplateMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  resource  Resource?                 @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  chapter   Chapter?                  @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@map("schedule_template_tasks")
}

// ==========================================
// USER STUDY PLANS (Personal Instances)
// ==========================================

model StudyPlan {
  id                String                @id @default(cuid())
  userId            String
  title             String
  description       String?
  sourceType        StudyPlanSource
  sourceTemplateId  String?
  startDate         DateTime?
  targetExamDate    DateTime?
  endDate           DateTime?
  status            StudyPlanStatus       @default(ACTIVE)
  isActive          Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  lastRescheduledAt DateTime?
  rescheduleHistory StudyPlanReschedule[]

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceTemplate    ScheduleTemplate?    @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  milestones        StudyPlanMilestone[]
  airecommendations AIRecommendation[]

  @@index([userId])
  @@index([status])
  @@map("study_plans")
}

model StudyPlanMilestone {
  id            String          @id @default(cuid())
  planId        String
  title         String
  description   String?
  order         Int             @default(0)
  systemId      String?
  startDate     DateTime?
  targetEndDate DateTime?
  status        MilestoneStatus @default(NOT_STARTED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  plan   StudyPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  system UsmleSystem?    @relation(fields: [systemId], references: [id], onDelete: SetNull)
  tasks  StudyPlanTask[]

  @@map("study_plan_milestones")
}

model StudyPlanTask {
  id                    String     @id @default(cuid())
  milestoneId           String
  title                 String
  description           String?
  type                  TaskType
  resourceId            String?
  chapterId             String?
  estimatedHours        Float?
  scheduledDate         DateTime?
  status                TaskStatus @default(PENDING)
  completedAt           DateTime?
  originalScheduledDate DateTime?
  isOptional            Boolean    @default(false)
  order                 Int        @default(0)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  milestone StudyPlanMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  resource  Resource?          @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  chapter   Chapter?           @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@index([milestoneId])
  @@index([status])
  @@index([scheduledDate])
  @@map("study_plan_tasks")
}

// ==========================================
// STUDY PARTNERS
// ==========================================

model StudyPartnerRequest {
  id         String               @id @default(cuid())
  senderId   String
  receiverId String
  message    String?
  status     PartnerRequestStatus @default(PENDING)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  sender   User @relation("SentPartnerRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedPartnerRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId, status])
  @@index([receiverId, status])
  @@map("study_partner_requests")
}

// ==========================================
// STUDY GROUPS
// ==========================================

model StudyGroup {
  id                 String          @id @default(cuid())
  name               String
  description        String?
  goal               String?
  currentSystemId    String?
  currentChapterId   String?
  studyLocationId    String?
  preferredStudyTime String?
  maxMembers         Int?
  visibility         GroupVisibility @default(PUBLIC)
  status             GroupStatus     @default(ACTIVE)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  currentSystem  UsmleSystem?   @relation("GroupCurrentSystem", fields: [currentSystemId], references: [id], onDelete: SetNull)
  currentChapter Chapter?       @relation("GroupCurrentChapter", fields: [currentChapterId], references: [id], onDelete: SetNull)
  studyLocation  StudyLocation? @relation("GroupStudyLocation", fields: [studyLocationId], references: [id], onDelete: SetNull)
  members        GroupMember[]
  conversation   Conversation?

  @@index([currentSystemId])
  @@index([currentChapterId])
  @@index([visibility])
  @@index([status])
  @@map("study_groups")
}

model GroupMember {
  id        String          @id @default(cuid())
  groupId   String
  userId    String
  role      GroupMemberRole @default(MEMBER)
  status    String          @default("ACTIVE")
  joinedAt  DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  group StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([status])
  @@map("group_members")
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  study     Boolean  @default(true)
  partners  Boolean  @default(true)
  messages  Boolean  @default(true)
  groups    Boolean  @default(true)
  ai        Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model StudyPlanReschedule {
  id          String            @id @default(cuid())
  studyPlanId String
  studyPlan   StudyPlan         @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  trigger     RescheduleTrigger
  daysBehind  Int
  tasksMoved  Int
  oldEndDate  DateTime?
  newEndDate  DateTime?

  @@index([studyPlanId])
}

enum RescheduleTrigger {
  AUTO
  MANUAL
}

model AIRecommendation {
  id          String    @id @default(cuid())
  userId      String
  studyPlanId String
  studyPlan   StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  type        String
  summary     String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  @@index([userId, studyPlanId, type, createdAt])
  @@index([userId, type, createdAt])
}

// ─── MESSAGING ────────────────────────────────────

model Conversation {
  id           String           @id @default(cuid())
  type         ConversationType @default(DIRECT)
  participantA String?
  participantB String?
  groupId      String?          @unique
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  participantAUser User?                @relation("ConvoParticipantA", fields: [participantA], references: [id], onDelete: Cascade)
  participantBUser User?                @relation("ConvoParticipantB", fields: [participantB], references: [id], onDelete: Cascade)
  group            StudyGroup?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  members          ConversationMember[]
  messages         Message[]

  @@unique([participantA, participantB])
  @@index([participantA])
  @@index([participantB])
  @@index([groupId])
  @@map("conversations")
}

model ConversationMember {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String    @db.Text
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  editedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

enum ConversationType {
  DIRECT
  GROUP
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  admin User @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}
